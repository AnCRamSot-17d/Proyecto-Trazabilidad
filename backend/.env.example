# Conexión a Neon PostgreSQL Serverless (Pooler para runtime, Direct para migraciones)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-project-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-project.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Puerto del servidor backend Express
PORT=3000
APP_PORT=3000

# Seguridad JWT (Sesiones de 30 minutos)
JWT_SECRET="your-super-secret-jwt-key"

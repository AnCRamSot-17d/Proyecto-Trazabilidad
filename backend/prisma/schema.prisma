generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Cliente {
  id               String     @id @default(uuid()) @db.Uuid
  nombre_empresa   String     @unique @db.VarChar(150)
  persona_contacto String     @db.VarChar(150)
  email            String     @db.VarChar(150)
  telefono         String     @db.VarChar(50)
  direccion        String?    @db.VarChar(255)
  creado_en        DateTime   @default(now())
  pedidos          Pedido[]
  productos        Producto[]

  @@map("clientes")
}

model Pedido {
  id            String            @id @default(uuid()) @db.Uuid
  numero_pedido String            @unique
  cliente_id    String            @db.Uuid
  estado        String            @default("PENDIENTE")
  fecha_pedido  DateTime          @default(now())
  cliente       Cliente           @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  detalles      DetallePedido[]
  ordenes       OrdenProduccion[]

  @@index([cliente_id])
  @@map("pedidos")
}

model DetallePedido {
  id              String  @id @default(uuid()) @db.Uuid
  pedido_id       String  @db.Uuid
  nombre_producto String  @db.VarChar(255)
  presentacion    String  @db.VarChar(100)
  cantidad        Int
  precio_unitario Decimal @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(12, 2)
  pedido          Pedido  @relation(fields: [pedido_id], references: [id], onDelete: Cascade)

  @@index([pedido_id])
  @@map("detalle_pedido")
}

model Producto {
  id              String                 @id @default(uuid()) @db.Uuid
  cliente_id      String?                @db.Uuid
  codigo_unico    String                 @unique
  nombre_producto String
  presentaciones  String?
  fecha_creacion  DateTime               @default(now())
  cliente         Cliente?               @relation(fields: [cliente_id], references: [id], onDelete: SetNull)
  formula         ProductoMateriaPrima[]
  ordenes         OrdenProduccion[]

  @@index([cliente_id])
  @@map("productos")
}

model MateriaPrima {
  id                   String                       @id @default(uuid()) @db.Uuid
  codigo_materia_prima String                       @unique
  nombre_insumo        String
  unidad_medida        String
  inventarios          InventarioMateriaPrima[]
  formulas             ProductoMateriaPrima[]
  ingresos             IngresoMateriaPrima[]
  detalles_consumo     DetalleConsumoMateriaPrima[]

  @@map("materia_prima")
}

model ProductoMateriaPrima {
  id                      String       @id @default(uuid()) @db.Uuid
  producto_id             String       @db.Uuid
  materia_prima_id        String       @db.Uuid
  porcentaje_o_proporcion Decimal      @db.Decimal(10, 4)
  producto                Producto     @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  materia_prima           MateriaPrima @relation(fields: [materia_prima_id], references: [id], onDelete: Restrict)

  @@unique([producto_id, materia_prima_id])
  @@map("producto_materia_prima")
}

model InventarioMateriaPrima {
  id                  String                       @id @default(uuid()) @db.Uuid
  materia_prima_id    String                       @db.Uuid
  lote_interno        String                       @unique
  stock_disponible    Decimal                      @db.Decimal(12, 4)
  fecha_actualizacion DateTime                     @default(now())
  materia_prima       MateriaPrima                 @relation(fields: [materia_prima_id], references: [id], onDelete: Restrict)
  ingresos            IngresoMateriaPrima[]
  detalles_consumo    DetalleConsumoMateriaPrima[]

  @@index([materia_prima_id])
  @@map("inventario_materia_prima")
}

model IngresoMateriaPrima {
  id                String                 @id @default(uuid()) @db.Uuid
  materia_prima_id  String                 @db.Uuid
  inventario_id     String                 @db.Uuid
  lote_proveedor    String
  cantidad_recibida Decimal                @db.Decimal(12, 4)
  proveedor         String
  fecha_ingreso     DateTime               @default(now())
  materia_prima     MateriaPrima           @relation(fields: [materia_prima_id], references: [id], onDelete: Restrict)
  inventario        InventarioMateriaPrima @relation(fields: [inventario_id], references: [id], onDelete: Restrict)

  @@index([materia_prima_id])
  @@index([inventario_id])
  @@map("ingreso_materia_prima")
}

model OrdenProduccion {
  id                     String                                @id @default(uuid()) @db.Uuid
  pedido_id              String?                               @db.Uuid
  producto_id            String                                @db.Uuid
  lote                   String                                @unique @db.VarChar(100)
  nombre_producto        String                                @db.VarChar(255)
  nombre_fantasia        String?                               @db.VarChar(255)
  marca                  String                                @db.VarChar(100)
  cantidad_programada    Decimal                               @db.Decimal(12, 4)
  presentacion           String                                @db.VarChar(100)
  notificacion_sanitaria String?                               @db.VarChar(100)
  estado_general         String                                @default("EN_PROCESO") @db.VarChar(50)
  creado_en              DateTime                              @default(now())
  pedido                 Pedido?                               @relation(fields: [pedido_id], references: [id], onDelete: SetNull)
  producto               Producto                              @relation(fields: [producto_id], references: [id], onDelete: Restrict)
  consumos               ConsumoMateriaPrima[]
  dispensacion           RegistroDispensacion?
  fabricaciones          RegistroFabricacion[]
  controles_calidad      RegistroControlCalidad[]
  envasados              RegistroEnvasado[]
  etiquetados            RegistroAcondicionamientoEtiquetado[]
  loteos                 RegistroAcondicionamientoLoteo[]

  @@index([pedido_id])
  @@index([producto_id])
  @@map("orden_produccion")
}

model ConsumoMateriaPrima {
  id                   String                       @id @default(uuid()) @db.Uuid
  orden_id             String                       @db.Uuid
  lote_total_fabricar  Decimal                      @db.Decimal(12, 4)
  unidad_lote          String
  fecha_consumo        DateTime                     @default(now())
  codigo_balanza       String?
  total_programado     Decimal                      @default(0) @db.Decimal(12, 4)
  total_real_consumido Decimal                      @default(0) @db.Decimal(12, 4)
  variacion_diferencia Decimal                      @default(0) @db.Decimal(12, 4)
  orden                OrdenProduccion              @relation(fields: [orden_id], references: [id], onDelete: Cascade)
  detalles             DetalleConsumoMateriaPrima[]

  @@index([orden_id])
  @@map("consumo_materia_prima")
}

model DetalleConsumoMateriaPrima {
  id                  String                 @id @default(uuid()) @db.Uuid
  consumo_id          String                 @db.Uuid
  materia_prima_id    String                 @db.Uuid
  inventario_id       String                 @db.Uuid
  cantidad_programada Decimal                @db.Decimal(12, 4)
  peso_real_consumido Decimal                @default(0) @db.Decimal(12, 4)
  consumo             ConsumoMateriaPrima    @relation(fields: [consumo_id], references: [id], onDelete: Cascade)
  materia_prima       MateriaPrima           @relation(fields: [materia_prima_id], references: [id], onDelete: Restrict)
  inventario          InventarioMateriaPrima @relation(fields: [inventario_id], references: [id], onDelete: Restrict)

  @@index([consumo_id])
  @@index([materia_prima_id])
  @@index([inventario_id])
  @@map("detalle_consumo_materia_prima")
}

model RegistroDispensacion {
  id                    String          @id @default(uuid()) @db.Uuid
  orden_id              String          @unique @db.Uuid
  fecha_produccion      DateTime        @default(now())
  balanza_codigo        String          @db.VarChar(50)
  despeje_puede_iniciar Boolean         @default(true)
  autorizado_por        String          @db.VarChar(150)
  orden                 OrdenProduccion @relation(fields: [orden_id], references: [id], onDelete: Cascade)

  @@map("registro_dispensacion")
}

model RegistroFabricacion {
  id                    String            @id @default(uuid()) @db.Uuid
  orden_id              String            @db.Uuid
  fecha                 DateTime          @default(now())
  despeje_puede_iniciar Boolean           @default(true)
  verificado_por        String            @db.VarChar(150)
  orden                 OrdenProduccion   @relation(fields: [orden_id], references: [id], onDelete: Cascade)
  pasos                 PasoFabricacion[]

  @@index([orden_id])
  @@map("registro_fabricacion")
}

model PasoFabricacion {
  id             String              @id @default(uuid()) @db.Uuid
  fabricacion_id String              @db.Uuid
  paso_numero    Int
  procedimiento  String              @db.Text
  rpm            String?             @db.VarChar(50)
  temperatura    String?             @db.VarChar(50)
  tiempo         String?             @db.VarChar(50)
  fabricacion    RegistroFabricacion @relation(fields: [fabricacion_id], references: [id], onDelete: Cascade)

  @@index([fabricacion_id])
  @@map("paso_fabricacion")
}

model RegistroControlCalidad {
  id               String             @id @default(uuid()) @db.Uuid
  orden_id         String             @db.Uuid
  fecha            DateTime           @default(now())
  muestra_aprobada Boolean            @default(false)
  analizado_por    String             @db.VarChar(150)
  revisado_por     String             @db.VarChar(150)
  orden            OrdenProduccion    @relation(fields: [orden_id], references: [id], onDelete: Cascade)
  parametros       ParametroCalidad[]

  @@index([orden_id])
  @@map("registro_control_calidad")
}

model ParametroCalidad {
  id                 String                 @id @default(uuid()) @db.Uuid
  control_calidad_id String                 @db.Uuid
  parametro          String                 @db.VarChar(255)
  especificacion     String                 @db.VarChar(255)
  resultado          String                 @db.VarChar(255)
  cumple             Boolean                @default(true)
  control_calidad    RegistroControlCalidad @relation(fields: [control_calidad_id], references: [id], onDelete: Cascade)

  @@index([control_calidad_id])
  @@map("parametro_calidad")
}

model RegistroEnvasado {
  id                        String          @id @default(uuid()) @db.Uuid
  orden_id                  String          @db.Uuid
  fecha_envasado            DateTime        @default(now())
  total_unidades            Decimal         @db.Decimal(12, 2)
  densidad                  Decimal         @db.Decimal(10, 4)
  balance_cantidad_envasada Decimal         @db.Decimal(12, 4)
  firma_responsable_nombre  String          @db.VarChar(150)
  orden                     OrdenProduccion @relation(fields: [orden_id], references: [id], onDelete: Cascade)

  @@index([orden_id])
  @@map("registro_envasado")
}

model RegistroAcondicionamientoEtiquetado {
  id                     String          @id @default(uuid()) @db.Uuid
  orden_id               String          @db.Uuid
  fecha                  DateTime        @default(now())
  ctrl_etiqueta_correcta Boolean         @default(true)
  ctrl_no_se_desprende   Boolean         @default(true)
  ctrl_codigo_barras     Boolean         @default(true)
  orden                  OrdenProduccion @relation(fields: [orden_id], references: [id], onDelete: Cascade)

  @@index([orden_id])
  @@map("registro_acondicionamiento_etiquetado")
}

model RegistroAcondicionamientoLoteo {
  id                       String          @id @default(uuid()) @db.Uuid
  orden_id                 String          @db.Uuid
  fecha                    DateTime        @default(now())
  balance_cantidad_loteada Decimal         @db.Decimal(12, 2)
  porcentaje_rendimiento   Decimal         @db.Decimal(5, 2)
  porcentaje_desperdicio   Decimal         @db.Decimal(5, 2)
  aprobado_por_calidad     String          @db.VarChar(150)
  orden                    OrdenProduccion @relation(fields: [orden_id], references: [id], onDelete: Cascade)

  @@index([orden_id])
  @@map("registro_acondicionamiento_loteo")
}

model Usuario {
  id             String             @id @default(uuid()) @db.Uuid
  email          String             @unique
  nombre         String
  password       String
  rol            String             @default("ADMINISTRADOR")
  estacion       String?            @default("Estación Principal de Control")
  activo         Boolean            @default(true)
  fecha_creacion DateTime           @default(now())
  ingresos       HistorialIngreso[]

  @@map("usuarios")
}

model HistorialIngreso {
  id            String   @id @default(uuid()) @db.Uuid
  usuario_id    String?  @db.Uuid
  direccion_ip  String   @db.VarChar(100)
  esta_en_linea Boolean  @default(true)
  fecha_ingreso DateTime @default(now())
  usuario       Usuario? @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([usuario_id, fecha_ingreso])
  @@map("historial_ingresos")
}

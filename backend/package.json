{
  "name": "proyecto-trazabilidad-backend",
  "version": "1.0.0",
  "description": "Backend API REST con arquitectura en capas para Sistema Universal de Trazabilidad Industrial y Manufactura Multiproducto (Node.js, Express, Prisma, PostgreSQL)",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "tsx --test tests/api.integration.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.15.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
